# KolleK Docker and self-hosting configuration.
#
# Copy this file to .env, then set a unique APP_KEY:
#   docker compose run --rm app php artisan key:generate --show
# Paste the printed value below, review the passwords, and run:
#   docker compose up -d --build

# --- Application ---
APP_NAME=Kollek
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Host port the web container is published on (maps to port 80 inside).
APP_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# --- Reverse proxy ---
# The proxies in front of this instance, comma separated. Required when something
# else terminates TLS (Traefik, Caddy, nginx, a CDN): without it the application
# never learns the visitor arrived over https, so assets and form actions come out
# as http:// on an https:// page and browsers block them.
# Use * when the proxy has no fixed address, and only publish the app container to
# the proxy rather than to the host when you do.
TRUSTED_PROXIES=

# --- Logging ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (MySQL service) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kollek
DB_USERNAME=kollek
DB_PASSWORD=change-me-please
# Used by the MySQL container for the root account and its health check.
DB_ROOT_PASSWORD=change-me-too

# Set to false to manage migrations yourself instead of on container start.
RUN_MIGRATIONS=true

# --- Sessions / cache / queue (database-backed by default; no extra service) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# Cache headers on the public marketing site and docs, telling whatever CDN sits
# in front of the instance to hold a page for a week and the visitor's browser to
# hold it for five minutes. Nothing is cached on the instance itself.
CACHE_PUBLIC_PAGES=true

# Purging that CDN cache when something the public site shows changes. Only used
# when the site is served through Cloudflare: leave both empty otherwise. The
# token needs the Cache Purge permission on the zone.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# --- Support ---
# End user support section. Off by default: only turn it on if someone is
# reading the inbox. When on, the sidebar link and every support route appear.
SUPPORT_ENABLED=false

# --- Hosting mode ---
# Whether this is the managed instance we run and charge for. Leave it off when
# you self host: your instance then has no item limit, no upgrade screen and
# nothing to buy.
HOSTED_INSTANCE=false

# --- Filesystem (uploaded item photos) ---
FILESYSTEM_DISK=local

# --- Mail ---
# Replace with your SMTP or Resend credentials to send real email.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Kollek"

# --- Misc ---
ACCOUNT_DELETION_NOTIFICATION_EMAIL="hello@example.com"

# How many days deleted objects stay in the trash before the scheduler purges them.
TRASH_RETENTION_DAYS=30

# --- Spam protection ---
# Set to true to put a Cloudflare Turnstile widget on the sign in, sign up and
# password reset forms. It needs a Cloudflare account, and both keys below, so
# it is off by default. With it on, your instance has to reach Cloudflare for
# anyone to sign in.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Marketing site ---
# Set to true to serve the public marketing site (homepage and API reference).
SHOW_MARKETING_SITE=false

# The address the media kit publishes for journalists. Left empty, the kit sends
# them to the GitHub discussions instead, which is what a self hosted instance
# usually wants: the address in the code belongs to the upstream project.
PRESS_EMAIL=
