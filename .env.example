APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Comma separated proxies in front of the instance, or * for any. Needed when
# something else terminates TLS, so https is detected and links are not http://.
# TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Cache headers on the public marketing site and docs, telling whatever CDN sits
# in front of the instance to hold a page for a week and the visitor's browser to
# hold it for five minutes.
CACHE_PUBLIC_PAGES=true

# Purging that CDN cache when something the public site shows changes. Only used
# when the site is served through Cloudflare: leave both empty otherwise. The
# token needs the Cache Purge permission on the zone.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# End user support section. Off by default: only turn it on if someone is
# reading the inbox. When on, the sidebar link and every support route appear.
SUPPORT_ENABLED=false

# Whether this is the managed instance we run and charge for. Off by default, so
# a self hosted instance has no item limit and nothing to buy. When on, an
# account holds ten items for free, five more as a grace, and then has to be
# unlocked with a one time payment.
HOSTED_INSTANCE=false

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ACCOUNT_DELETION_NOTIFICATION_EMAIL="hello@example.com"

# Set to true to serve the public marketing site (homepage and API reference).
SHOW_MARKETING_SITE=false

# Set to true to put a Cloudflare Turnstile widget on the sign in, sign up and
# password reset forms. It needs a Cloudflare account, and both keys below, so it
# is off by default. With it on, the instance has to reach Cloudflare for anyone
# to sign in.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The address the media kit publishes for journalists. Left empty, the kit sends
# them to the GitHub discussions instead, which is what a self hosted instance
# usually wants: the address in the code belongs to the upstream project.
PRESS_EMAIL=
